{
  "manifest_path": "FILETREE.md",
  "hash_path": "FILETREE.hash.json",
  "language": "en",
  "include": [],
  "exclude": [
    ".git/**",
    ".dart_tool/**",
    ".idea/**",
    ".vscode/**",
    ".vscode-test/**",
    ".venv/**",
    "venv/**",
    "node_modules/**",
    "build/**",
    "dist/**",
